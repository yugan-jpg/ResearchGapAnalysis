# Copy this file to .env and replace placeholders. Never commit .env.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
MONGODB_DATABASE=scientific_literature_gap_discovery
LLM_API_KEY=replace-with-your-provider-key
LLM_MODEL_NAME=qwen/qwen3.8-27b
LLM_API_URL=https://api.groq.com/openai/v1/chat/completions
LLM_API_AUTH_HEADER=Authorization
LLM_API_AUTH_PREFIX=Bearer
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
CLAIM_EXTRACTION_MAX_CLAIMS=8

# Groq verifier shares LLM_API_KEY and LLM_API_URL.
VERIFIER_ENABLED=true
VERIFIER_MODEL_NAME=openai/gpt-oss-120b
VERIFIER_TIMEOUT_SECONDS=60
VERIFIER_MAX_RETRIES=2
VERIFIER_BATCH_SIZE=3
VERIFIER_COMPARISON_LIMIT=8
# Optional per-model local budgets; 0 disables that local budget.
LLM_TOKENS_PER_MINUTE=0
VERIFIER_TOKENS_PER_MINUTE=0
LLM_REQUESTS_PER_MINUTE=0
VERIFIER_REQUESTS_PER_MINUTE=0
GROQ_RATE_SAFETY_FRACTION=0.9
GROQ_ESTIMATED_OUTPUT_TOKENS=1024
GROQ_MAX_THROTTLE_WAIT_SECONDS=120
VERIFIER_MALFORMED_RETRIES=1
FRONTEND_URL=http://localhost:5173
AUTO_INITIALIZE_DATABASE=false

# Phase 2 PDF ingestion controls.
PDF_MAX_UPLOAD_BYTES=20971520
PDF_CHUNK_SIZE=1200
PDF_CHUNK_OVERLAP=200

# Phase 3 local embeddings and Atlas Vector Search.
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
EMBEDDING_BATCH_SIZE=16
EMBEDDING_DEVICE=cpu
VECTOR_SEARCH_INDEX_NAME=paper_chunks_vector_index
VECTOR_SEARCH_CANDIDATE_MULTIPLIER=10
